# RepoLaunch Konfiguration. Kopieren nach .env und anpassen. Keine echten Geheimnisse einchecken.

# Datenverzeichnis für SQLite (persistent halten und sichern)
REPOLAUNCH_DATA_DIR=./data

# Optional: GitHub-Token ohne Scopes (nur für höhere Ratenlimits bei öffentlichen Repositories).
# Ohne Token gilt das Limit von 60 Anfragen pro Stunde und IP; ein Audit braucht etwa 7 bis 12 Anfragen.
GITHUB_TOKEN=

# Demo-Modus mit erfundenen Fixtures in der Oberfläche (deutlich gekennzeichnet)
REPOLAUNCH_DEMO=0

# Aufbewahrung und Limits
JOB_TTL_HOURS=72
MAX_ACTIVE_JOBS=20
MAX_JOB_ATTEMPTS=3
RATE_LIMIT_JOBS_PER_HOUR=10
RATE_LIMIT_AI_PER_HOUR=3
RATE_LIMIT_READS_PER_MINUTE=120
# Anzahl vertrauenswürdiger Reverse Proxys vor der App (0 = X-Forwarded-For ignorieren, alle Clients teilen ein Limit)
TRUST_PROXY_HOPS=0

# Optionales KI-Launch-Paket: none | anthropic | fake (deterministischer Testadapter)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Serverseitiger Fallback bei Ablehnung durch Sicherheitsklassifikatoren (Beta). Wird im Kostenbudget als Worst Case berücksichtigt.
ANTHROPIC_FALLBACKS=1
# Nur nötig für Modelle ohne hinterlegten Preis (USD pro Million Token)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_MAX_COST_USD=1.00
AI_MAX_OUTPUT_TOKENS=16000
AI_MAX_INPUT_CHARS=30000
AI_MAX_README_CHARS=16000
AI_TIMEOUT_MS=180000
AI_MAX_RUNS_PER_JOB=2

# Optional: Pfad zu einer JSON-Datei mit Regel-Überschreibungen (siehe rules.example.json)
REPOLAUNCH_RULES_CONFIG=

# Ausgehender HTTPS-Proxy (Node >= 22.21 bzw. 24.5): HTTPS_PROXY setzen und NODE_USE_ENV_PROXY=1
# NODE_USE_ENV_PROXY=1
