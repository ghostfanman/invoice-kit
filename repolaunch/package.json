{
  "name": "repolaunch",
  "version": "0.1.0",
  "private": true,
  "description": "Belegbarer Repository-Audit, priorisierte Aufgaben und optionales KI-Launch-Paket für GitHub-Maintainer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "examples": "tsx scripts/generate-examples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "fflate": "0.8.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.11.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "playwright-core": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
